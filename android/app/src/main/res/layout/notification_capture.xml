<?xml version="1.0" encoding="utf-8"?>
<!-- 记录通知：收起状态下就能看到按钮，一下暂停、继续或开始。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/text"
            style="@android:style/TextAppearance.Material.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/stop"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notification_soft"
        android:contentDescription="@string/action_stop"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_stat_stop_ink" />

    <ImageButton
        android:id="@+id/toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_notification_button"
        android:contentDescription="@string/action_toggle"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_stat_pause" />
</LinearLayout>
